pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(daysToKeepStr: '30', numToKeepStr: '50'))
        timeout(time: 25, unit: 'MINUTES')
    }
    triggers { pollSCM('H/30 * * * *') }
    environment {
        APP_NAME = 'personal-system-inspector'
        DEPLOY_ROOT = '/opt/personal-system-inspector'
        INTERNAL_PORT = '31880'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.RELEASE_ID = "${env.BUILD_NUMBER}-${env.GIT_SHORT_SHA}"
                    env.REMOTE_WORKSPACE = "/tmp/personal-inspector-jenkins-${env.BUILD_NUMBER}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.GIT_SHORT_SHA}"
                }
            }
        }
        stage('Credential Check') {
            steps {
                withCredentials([
                    string(credentialsId: 'personal-inspector-app-secret', variable: 'C_APP_SECRET'),
                    string(credentialsId: 'personal-inspector-admin-password', variable: 'C_ADMIN_PASSWORD'),
                    string(credentialsId: 'personal-inspector-run-token', variable: 'C_RUN_TOKEN'),
                    string(credentialsId: 'personal-inspector-smtp-env', variable: 'C_SMTP_ENV_B64'),
                    usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-centos-ssh', usernameVariable: 'C_CENTOS_USER', passwordVariable: 'C_CENTOS_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-postgres', usernameVariable: 'C_POSTGRES_USER', passwordVariable: 'C_POSTGRES_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-mysql', usernameVariable: 'C_MYSQL_USER', passwordVariable: 'C_MYSQL_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-jenkins-api', usernameVariable: 'C_JENKINS_USER', passwordVariable: 'C_JENKINS_TOKEN')
                ]) {
                    sh '''
                        set +x
                        for value in "$C_APP_SECRET" "$C_ADMIN_PASSWORD" "$C_RUN_TOKEN" "$C_SMTP_ENV_B64" "$C_UBUNTU_USER" "$C_UBUNTU_PASSWORD" "$C_CENTOS_USER" "$C_CENTOS_PASSWORD" "$C_POSTGRES_USER" "$C_POSTGRES_PASSWORD" "$C_MYSQL_USER" "$C_MYSQL_PASSWORD" "$C_JENKINS_USER" "$C_JENKINS_TOKEN"; do test -n "$value"; done
                        command -v sshpass >/dev/null
                        echo 'Required credentials and SSH transport are available (values hidden).'
                    '''
                }
            }
        }
        stage('Prepare Remote Workspace') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD')]) {
                    sh '''
                        set +x
                        export SSHPASS="$C_UBUNTU_PASSWORD"
                        tar --exclude=.git --exclude=.env --exclude=data --exclude=logs -czf - . | sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "mkdir -p '$REMOTE_WORKSPACE' && tar -xzf - -C '$REMOTE_WORKSPACE'"
                    '''
                }
            }
        }
        stage('Static Check') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD')]) {
                    sh '''
                        set +x
                        export SSHPASS="$C_UBUNTU_PASSWORD"
                        sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "cd '$REMOTE_WORKSPACE' && python3.12 -m venv .test-venv && PIP_DISABLE_PIP_VERSION_CHECK=1 .test-venv/bin/pip install --retries 5 --timeout 60 -e '.[dev]' && .test-venv/bin/ruff check ."
                    '''
                }
            }
        }
        stage('Pytest') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD')]) {
                    sh '''
                        set +x
                        export SSHPASS="$C_UBUNTU_PASSWORD"
                        sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "cd '$REMOTE_WORKSPACE' && .test-venv/bin/pytest -q"
                    '''
                }
            }
        }
        stage('Native Package Check') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD')]) {
                    sh '''
                        set +x
                        export SSHPASS="$C_UBUNTU_PASSWORD"
                        sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "cd '$REMOTE_WORKSPACE' && PYTHONPYCACHEPREFIX=.compile-cache .test-venv/bin/python -m compileall -q src && bash -n deploy/jenkins-deploy.sh"
                    '''
                }
            }
        }
        stage('Versioned Deploy and Health Check') {
            steps {
                withCredentials([
                    string(credentialsId: 'personal-inspector-app-secret', variable: 'C_APP_SECRET'),
                    string(credentialsId: 'personal-inspector-admin-password', variable: 'C_ADMIN_PASSWORD'),
                    string(credentialsId: 'personal-inspector-run-token', variable: 'C_RUN_TOKEN'),
                    string(credentialsId: 'personal-inspector-smtp-env', variable: 'C_SMTP_ENV_B64'),
                    usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-centos-ssh', usernameVariable: 'C_CENTOS_USER', passwordVariable: 'C_CENTOS_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-postgres', usernameVariable: 'C_POSTGRES_USER', passwordVariable: 'C_POSTGRES_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-mysql', usernameVariable: 'C_MYSQL_USER', passwordVariable: 'C_MYSQL_PASSWORD'),
                    usernamePassword(credentialsId: 'personal-inspector-jenkins-api', usernameVariable: 'C_JENKINS_USER', passwordVariable: 'C_JENKINS_TOKEN')
                ]) {
                    sh '''
                        set +x
                        export SSHPASS="$C_UBUNTU_PASSWORD"
                        {
                            printf 'C_APP_SECRET=%s\n' "$C_APP_SECRET"; printf 'C_ADMIN_PASSWORD=%s\n' "$C_ADMIN_PASSWORD"; printf 'C_RUN_TOKEN=%s\n' "$C_RUN_TOKEN"; printf 'C_SMTP_ENV_B64=%s\n' "$C_SMTP_ENV_B64"
                            printf 'C_UBUNTU_USER=%s\n' "$C_UBUNTU_USER"; printf 'C_UBUNTU_PASSWORD=%s\n' "$C_UBUNTU_PASSWORD"
                            printf 'C_CENTOS_USER=%s\n' "$C_CENTOS_USER"; printf 'C_CENTOS_PASSWORD=%s\n' "$C_CENTOS_PASSWORD"
                            printf 'C_POSTGRES_USER=%s\n' "$C_POSTGRES_USER"; printf 'C_POSTGRES_PASSWORD=%s\n' "$C_POSTGRES_PASSWORD"
                            printf 'C_MYSQL_USER=%s\n' "$C_MYSQL_USER"; printf 'C_MYSQL_PASSWORD=%s\n' "$C_MYSQL_PASSWORD"
                            printf 'C_JENKINS_USER=%s\n' "$C_JENKINS_USER"; printf 'C_JENKINS_TOKEN=%s\n' "$C_JENKINS_TOKEN"
                            printf 'BUILD_NUMBER=%s\nGIT_SHORT_SHA=%s\nGIT_COMMIT=%s\nRELEASE_ID=%s\n' "$BUILD_NUMBER" "$GIT_SHORT_SHA" "$GIT_COMMIT" "$RELEASE_ID"
                        } | sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "umask 077; cat > '$REMOTE_WORKSPACE/.jenkins-secrets'"
                        sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "cd '$REMOTE_WORKSPACE' && bash deploy/jenkins-deploy.sh"
                    '''
                }
            }
        }
    }
    post {
        always {
            withCredentials([usernamePassword(credentialsId: 'personal-inspector-ubuntu-ssh', usernameVariable: 'C_UBUNTU_USER', passwordVariable: 'C_UBUNTU_PASSWORD')]) {
                sh '''
                    set +x
                    export SSHPASS="$C_UBUNTU_PASSWORD"
                    sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$C_UBUNTU_USER@127.0.0.1" "rm -rf -- '${REMOTE_WORKSPACE:-/tmp/personal-inspector-jenkins-$BUILD_NUMBER}'" || true
                '''
            }
            echo "Build ${env.BUILD_NUMBER}; commit ${env.GIT_COMMIT}; release ${env.RELEASE_ID}"
        }
    }
}
