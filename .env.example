# 必须：生产环境请在 Jenkins Credentials 中维护，不要提交真实值
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_INITIAL_PASSWORD=replace-on-first-deploy
RUN_API_TOKEN=replace-with-a-long-random-token

# SMTP（未配置时仅生成邮件预览）
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# SSH 只读采集
UBUNTU_SSH_USERNAME=
UBUNTU_SSH_PASSWORD=
UBUNTU_SSH_KEY_PATH=
CENTOS_SSH_USERNAME=
CENTOS_SSH_PASSWORD=
CENTOS_SSH_KEY_PATH=
NAS_SSH_USERNAME=
NAS_SSH_PASSWORD=
NAS_SSH_KEY_PATH=

# 数据库
POSTGRES_HOST=
POSTGRES_PORT=15432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=mysql

# Jenkins 只读 API
JENKINS_URL=http://192.168.0.111:8080
JENKINS_USERNAME=
JENKINS_API_TOKEN=
